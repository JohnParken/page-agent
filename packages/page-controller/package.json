{
    "name": "@page-agent/page-controller",
    "version": "1.12.2",
    "type": "module",
    "main": "./src/PageController.ts",
    "types": "./src/PageController.ts",
    "exports": {
        ".": {
            "types": "./src/PageController.ts",
            "default": "./src/PageController.ts"
        },
        "./iframe-bridge": {
            "types": "./src/iframe-bridge/index.ts",
            "default": "./src/iframe-bridge/index.ts"
        },
        "./parent-bridge": {
            "types": "./src/parent-bridge/index.ts",
            "default": "./src/parent-bridge/index.ts"
        },
        "./parent-bridge/host": {
            "types": "./src/parent-bridge/host.ts",
            "default": "./src/parent-bridge/host.ts"
        },
        "./parent-bridge/adapter": {
            "types": "./src/parent-bridge/adapter.ts",
            "default": "./src/parent-bridge/adapter.ts"
        },
        "./parent-bridge/managed-auth": {
            "types": "./src/parent-bridge/managed-auth.ts",
            "default": "./src/parent-bridge/managed-auth.ts"
        },
        "./parent-bridge/host.css": {
            "default": "./src/browser/parent-host.css"
        }
    },
    "publishConfig": {
        "main": "./dist/lib/page-controller.js",
        "module": "./dist/lib/page-controller.js",
        "types": "./dist/lib/PageController.d.ts",
        "exports": {
            ".": {
                "types": "./dist/lib/PageController.d.ts",
                "import": "./dist/lib/page-controller.js",
                "default": "./dist/lib/page-controller.js"
            },
            "./iframe-bridge": {
                "types": "./dist/lib/iframe-bridge.d.ts",
                "import": "./dist/lib/iframe-bridge.js",
                "default": "./dist/lib/iframe-bridge.js"
            },
            "./parent-bridge": {
                "types": "./dist/lib/parent-bridge.d.ts",
                "import": "./dist/lib/parent-bridge.js",
                "default": "./dist/lib/parent-bridge.js"
            },
            "./parent-bridge/host": {
                "types": "./dist/lib/parent-bridge/host.d.ts",
                "import": "./dist/lib/parent-bridge/host.js",
                "default": "./dist/lib/parent-bridge/host.js"
            },
            "./parent-bridge/adapter": {
                "types": "./dist/lib/parent-bridge/adapter.d.ts",
                "import": "./dist/lib/parent-bridge/adapter.js",
                "default": "./dist/lib/parent-bridge/adapter.js"
            },
            "./parent-bridge/managed-auth": {
                "types": "./dist/lib/parent-bridge/managed-auth.d.ts",
                "import": "./dist/lib/parent-bridge/managed-auth.js",
                "default": "./dist/lib/parent-bridge/managed-auth.js"
            },
            "./parent-bridge/host.css": {
                "default": "./dist/iife/page-agent-parent-host.css"
            }
        }
    },
    "files": [
        "dist/"
    ],
    "description": "Page controller for page-agent - DOM operations and element interactions",
    "keywords": [
        "page-agent",
        "dom",
        "browser-automation",
        "web-automation"
    ],
    "author": "Simon<gaomeng1900>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/alibaba/page-agent.git",
        "directory": "packages/page-controller"
    },
    "homepage": "https://alibaba.github.io/page-agent/",
    "scripts": {
        "build": "vite build && tsup --config tsup.config.js && npm run build:iife",
        "build:iife": "vite build --config vite.iframe-iife.config.js && npm run build:parent-host",
        "build:parent-host": "vite build --config vite.parent-host-iife.config.js",
        "test": "vitest run",
        "prepublishOnly": "node ../../scripts/pre-publish.js",
        "postpublish": "node ../../scripts/post-publish.js"
    }
}
